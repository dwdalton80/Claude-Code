rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPremium() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile.isPremium == true;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      match /fcmTokens/{token} {
        allow read, write: if isOwner(uid);
      }

      match /aiUsage/{date} {
        allow read, write: if isOwner(uid);
      }

      match /debriefUsage/{month} {
        allow read, write: if isOwner(uid);
      }

      match /notes/{verseId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Bible (read-only for all authenticated users) ─────────────────────────
   match /bible/{version} {
      allow read: if isSignedIn();
      match /books/{bookId} {
        allow read: if isSignedIn();
        match /chapters/{chapterId} {
          allow read: if isSignedIn();
          match /verses/{verseId} {
            allow read: if isSignedIn();
          }
        }
      }
    }

    // ── Spark cache (read-only) ───────────────────────────────────────────────
   match /sparkcache/{date} {
      allow read: if isSignedIn();
      match /{passageId}/{version} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ── Daily cache (read-only) ───────────────────────────────────────────────
    match /dailycache/{date} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Highlights ─────────────────────────────────────────────────────────────
    match /highlights/{uid}/verses/{verseId} {
      allow read, write: if isOwner(uid);
    }

    // ── Journal ────────────────────────────────────────────────────────────────
    match /journal/{uid}/entries/{entryId} {
      allow read, write: if isOwner(uid);
    }

    // ── Badges ─────────────────────────────────────────────────────────────────
    match /badges/{uid}/earned/{badgeId} {
      allow read: if isSignedIn(); // others can see your badges
      allow write: if false;       // Cloud Functions only
    }

    // ── Reading plans ──────────────────────────────────────────────────────────
    match /readingPlans/{uid}/plans/{planId} {
      allow read, write: if isOwner(uid);
    }

    // ── Quiz history ───────────────────────────────────────────────────────────
    match /quizHistory/{uid}/quizzes/{quizId} {
      allow read, write: if isOwner(uid);
    }

    // ── Memory verses ──────────────────────────────────────────────────────────
    match /memoryVerses/{uid}/verses/{verseId} {
      allow read, write: if isOwner(uid);
    }

    // ── Study cache ────────────────────────────────────────────────────────────
    match /studycache/{uid}/passages/{passageId} {
      allow read, write: if isOwner(uid);
    }

    // ── Groups ─────────────────────────────────────────────────────────────────
  match /groups/{groupId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator' ||
        // Allow any signed-in user to add themselves to memberIds when joining
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'lastActivity'])
      );

      match /members/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid) ||
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator';
      }

      match /feed/{feedItemId} {
        allow read: if isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow create: if isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
      }
    }

    // ── Group comments ─────────────────────────────────────────────────────────
    match /groupComments/{docId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorId;
    }

    // ── Group questions ────────────────────────────────────────────────────────
    match /groupQuestions/{groupId}/questions/{questionId} {
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.authorUid ||
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator'
      );
    }
  }
}
