rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPremium() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profile.isPremium == true;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      match /fcmTokens/{token} {
        allow read, write: if isOwner(uid);
      }

      match /aiUsage/{date} {
        allow read, write: if isOwner(uid);
      }

      match /debriefUsage/{month} {
        allow read, write: if isOwner(uid);
      }

      match /notes/{verseId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Bible (read-only for all authenticated users) ─────────────────────────
   match /bible/{version} {
      allow read: if isSignedIn();
      match /books/{bookId} {
        allow read: if isSignedIn();
        match /chapters/{chapterId} {
          allow read: if isSignedIn();
          match /verses/{verseId} {
            allow read: if isSignedIn();
          }
        }
      }
    }

    // ── Spark cache (read-only) ───────────────────────────────────────────────
   match /sparkcache/{date} {
      allow read: if isSignedIn();
      match /{passageId}/{version} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ── Daily cache (read-only) ───────────────────────────────────────────────
    match /dailycache/{date} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Notes (reader inline notes, top-level collection) ────────────────────
    match /notes/{uid}/verses/{verseId} {
      allow read, write: if isOwner(uid);
    }

    // ── Dig Deeper notes entries ──────────────────────────────────────────────
    match /notes/{uid}/entries/{entryId} {
      allow read, write: if isOwner(uid);
    }

    // ── Highlights ─────────────────────────────────────────────────────────────
    match /highlights/{uid}/verses/{verseId} {
      allow read, write: if isOwner(uid);
    }

    // ── Journal ────────────────────────────────────────────────────────────────
    match /journal/{uid}/entries/{entryId} {
      allow read, write: if isOwner(uid);
    }

    // ── Badges ─────────────────────────────────────────────────────────────────
    match /badges/{uid}/earned/{badgeId} {
      allow read: if isSignedIn(); // others can see your badges
      allow write: if false;       // Cloud Functions only
    }

    // ── Reading plans ──────────────────────────────────────────────────────────
    match /readingPlans/{uid}/plans/{planId} {
      allow read, write: if isOwner(uid);
    }

    // ── Quiz history ───────────────────────────────────────────────────────────
    match /quizHistory/{uid}/quizzes/{quizId} {
      allow read, write: if isOwner(uid);
    }

    // ── Memory verses ──────────────────────────────────────────────────────────
    match /memoryVerses/{uid}/verses/{verseId} {
      allow read, write: if isOwner(uid);
    }

    // ── Study cache ────────────────────────────────────────────────────────────
    match /studycache/{uid}/passages/{passageId} {
      allow read, write: if isOwner(uid);
    }

    // ── Groups ─────────────────────────────────────────────────────────────────
  match /groups/{groupId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator' ||
        // Allow any signed-in user to update memberIds (joining or leaving)
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'memberCount', 'lastActivity'])
      );
      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid ||
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator'
      );

      match /members/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid) ||
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator';
      }

      match /activity/{activityId} {
        allow read: if isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow create: if isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.uid ||
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator'
        );
      }

      match /challenges/{challengeId} {
        allow read: if isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator';
        // Any member can update their own progress field; creator can update anything
        allow update: if isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow delete: if isSignedIn() &&
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator';
      }

      match /prayers/{prayerId} {
        allow read: if isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow create: if isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        // Author can mark answered; any member can toggle prayedBy/prayedCount
        allow update: if isSignedIn() && (
          request.auth.uid == resource.data.authorUid ||
          (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayedBy', 'prayedCount']))
        );
        allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
      }

      match /feed/{feedItemId} {
        allow read: if isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow create: if isSignedIn() &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        // Author can update/delete; any member can increment commentCount
        allow update: if isSignedIn() && (
          request.auth.uid == resource.data.authorUid ||
          (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']))
        );
        allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;

        match /replies/{replyId} {
          allow read: if isSignedIn() &&
            exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
          allow create: if isSignedIn() &&
            exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
          allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
        }
      }
    }

    // ── Dig Deeper reading plans ───────────────────────────────────────────────
    match /userPlans/{uid} {
      allow read, write: if isOwner(uid);
      match /active/{planId} {
        // Owner has full access; partner can read and set their own uid as partnerId
        allow read: if isOwner(uid)
          || (isSignedIn() && resource.data.partnerId == request.auth.uid);
        allow write: if isOwner(uid);
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerId'])
          && request.resource.data.partnerId == request.auth.uid
          && resource.data.ownerUid != request.auth.uid;
      }
    }

    // ── Partner plan invite links ──────────────────────────────────────────────
    match /partnerLinks/{code} {
      // Anyone signed in can read (to look up a code they received)
      allow read: if isSignedIn();
      // Only the owner can create their own link
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      // Anyone can claim an unclaimed link (sets partnerUid to their own uid)
      allow update: if isSignedIn()
        && resource.data.partnerUid == null
        && resource.data.ownerUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerUid'])
        && request.resource.data.partnerUid == request.auth.uid;
    }

    // ── Partner plan shared state ──────────────────────────────────────────────
    match /partnerPlans/{sharedPlanId} {
      // Any member of the plan can read
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;
      // Owner (first member) can create
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberUids;
      // Any member can update (mark day complete, add themselves as member)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;

      match /messages/{messageId} {
        // Only members can read/write chat messages
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/partnerPlans/$(sharedPlanId)).data.memberUids;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/partnerPlans/$(sharedPlanId)).data.memberUids
          && request.resource.data.authorUid == request.auth.uid;
      }
    }

    // ── Dig Deeper badges ──────────────────────────────────────────────────────
    match /digdeeperBadges/{uid} {
      allow read, write: if isOwner(uid);

      match /earned/{badgeId} {
        allow read: if isSignedIn();  // others can see your badges
        allow write: if isOwner(uid);
      }

      match /progress/{sourceId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Group comments ─────────────────────────────────────────────────────────
    match /groupComments/{docId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorId;
    }

    // ── Group questions ────────────────────────────────────────────────────────
    match /groupQuestions/{groupId}/questions/{questionId} {
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      allow create: if isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.authorUid ||
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator'
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.authorUid ||
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'creator'
      );
    }
  }
}
